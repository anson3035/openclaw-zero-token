# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (must support gpt-4o vision)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# SMTP for sending the report email (optional; only required for /send)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taiwan Violation Reporter <noreply@example.com>"

# Geocoding (uses OpenStreetMap Nominatim by default; no key needed)
# Set a contact email per Nominatim usage policy
NOMINATIM_USER_AGENT=taiwan-report-bot/0.1 (contact@example.com)

# Storage path for downloaded media (created if absent)
EVIDENCE_DIR=./evidence

# Persistent data dir for session store + audit log (created if absent)
DATA_DIR=./data

# Allowed Telegram user IDs (comma separated). Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (must support gpt-4o vision)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional second vision provider for cross-engine plate-recognition voting.
# When set, the LPR pipeline runs OpenAI + Gemini in parallel and boosts
# confidence when they agree on the plate. Free tier at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SMTP for sending the report email (optional; only required for /send)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taiwan Violation Reporter <noreply@example.com>"

# Geocoding (uses OpenStreetMap Nominatim by default; no key needed)
# Set a contact email per Nominatim usage policy
NOMINATIM_USER_AGENT=taiwan-report-bot/0.1 (contact@example.com)

# TDX (Transport Data eXchange, transportdata.tw) — official Taiwan
# transport open data. Register a free dev account to get credentials
# for higher rate limits. Without these the system falls back to
# anonymous access (rate-limited).
# Use cases in this app: validate violation location is on a real road,
# detect nearby bus stops (§56-1-4 第4款 evidence enhancer).
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Storage path for downloaded media (created if absent)
EVIDENCE_DIR=./evidence

# Persistent data dir for session store + audit log (created if absent)
DATA_DIR=./data

# Allowed Telegram user IDs (comma separated). Leave empty to allow everyone.
ALLOWED_USER_IDS=
